# =============================================================================
# DENTALOS ENTERPRISE DPMS - ENVIRONMENT CONFIGURATION
# =============================================================================

# --- APP CORE ---
APP_NAME=DentalOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

# --- DATABASE ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dentalms
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=null

# --- CACHE & QUEUE ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_URL=null
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=
ENCRYPTION_KEY= # 32-byte AES key
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
JWT_ALGO=HS256

# --- AWS INFRASTRUCTURE ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# --- COMMUNICATIONS (SMS & EMAIL) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SENDGRID_API_KEY=
RESEND_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@dentalos.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PAYMENTS ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SEARCH ---
ELASTICSEARCH_URL=http://localhost:9200

# --- THIRD-PARTY INTEGRATIONS ---
# Claims & Clearinghouse
CLEARINGHOUSE_API_KEY=
CLEARINGHOUSE_API_URL=

# E-Prescribing (DoseSpot)
DOSESPOT_CLINIC_ID=
DOSESPOT_CLINICIAN_ID=
DOSESPOT_API_KEY=

# Webhooks & External Systems
CARESTACK_WEBHOOK_SECRET=

# --- FRONTEND (NODE / VITE / NEXT.JS) ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MONITORING ---
SENTRY_DSN=
DATADOG_API_KEY=
