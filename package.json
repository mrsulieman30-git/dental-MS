{
  "name": "dentalos-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix dentalos",
    "serve": "php dentalos/artisan serve",
    "db:fresh": "php dentalos/artisan migrate:fresh --seed",
    "db:clear": "php dentalos/artisan optimize:clear",
    "test:api": "php dentalos/artisan test --project dentalos",
    "stage1:verify": "npm run db:fresh && npm run db:clear && npm run test:api",
    "dev:web": "npm run dev --workspace=@dentalos/web",
    "build:web": "npm run build --workspace=@dentalos/web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4"
  }
}
